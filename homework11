
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

long long insertion_sort(int a[], int n) {
    long long count = 0;

    for (int i = 1; i < n; i++) {
        int key = a[i];
        int j = i - 1;

        while (j >= 0) {
            count++;

            if (a[j] > key) {
                a[j + 1] = a[j];
                j--;
            }
            else {
                break;
            }
        }

        a[j + 1] = key;
    }

    return count;
}

long long shell_original(int a[], int n) {
    long long count = 0;

    for (int gap = n / 2; gap >= 1; gap /= 2) {
        for (int i = gap; i < n; i++) {
            int key = a[i];
            int j = i;

            while (j >= gap) {
                count++;

                if (a[j - gap] > key) {
                    a[j] = a[j - gap];
                    j -= gap;
                }
                else {
                    break;
                }
            }

            a[j] = key;
        }
    }

    return count;
}

long long shell_knuth(int a[], int n) {
    long long count = 0;
    int gap = 1;

    while (gap < n / 3)
        gap = 3 * gap + 1;

    for (; gap >= 1; gap /= 3) {
        for (int i = gap; i < n; i++) {
            int key = a[i];
            int j = i;

            while (j >= gap) {
                count++;

                if (a[j - gap] > key) {
                    a[j] = a[j - gap];
                    j -= gap;
                }
                else {
                    break;
                }
            }

            a[j] = key;
        }
    }

    return count;
}

int check_sort(int a[], int n) {
    for (int i = 1; i < n; i++) {
        if (a[i - 1] > a[i])
            return 0;
    }

    return 1;
}

int main() {
    int sizes[] = { 1000, 2000, 4000, 8000, 16000, 20000 };
    int size_count = 6;

    srand((unsigned int)time(NULL));

    for (int k = 0; k < size_count; k++) {
        int n = sizes[k];

        int* original = malloc(sizeof(int) * n);
        int* a = malloc(sizeof(int) * n);
        int* b = malloc(sizeof(int) * n);
        int* c = malloc(sizeof(int) * n);

        if (original == NULL || a == NULL ||
            b == NULL || c == NULL) {
            printf("Memory allocation failed.\n");
            free(original);
            free(a);
            free(b);
            free(c);
            return 1;
        }

        for (int i = 0; i < n; i++)
            original[i] = rand();

        for (int i = 0; i < n; i++) {
            a[i] = original[i];
            b[i] = original[i];
            c[i] = original[i];
        }

        long long insertion = insertion_sort(a, n);
        long long original_shell = shell_original(b, n);
        long long knuth_shell = shell_knuth(c, n);

        printf("\nData Size : %d\n", n);

        printf("Insertion Sort       : %lld comparisons (%s)\n",
            insertion, check_sort(a, n) ? "OK" : "ERROR");

        printf("Shell Sort (Original): %lld comparisons (%s)\n",
            original_shell, check_sort(b, n) ? "OK" : "ERROR");

        printf("Shell Sort (Knuth)   : %lld comparisons (%s)\n",
            knuth_shell, check_sort(c, n) ? "OK" : "ERROR");

        free(original);
        free(a);
        free(b);
        free(c);
    }

    return 0;
}
