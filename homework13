
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

unsigned long long comparisons = 0;
int maxDepth = 0;

typedef struct {
    int left, right, mid;
    int i, j, k;
    int depth;
} MergeFrame;

typedef struct {
    int low, high;
    int lt, i, gt;
    int pivot, pivotIndex;
    int x, y, z, temp;
    int depth;
} QuickFrame;

// 병합 정렬
void mergeSort(int a[], int temp[], int left, int right, int depth) {
    MergeFrame f;

    f.left = left;
    f.right = right;
    f.depth = depth;

    if (depth > maxDepth)
        maxDepth = depth;

    if (left >= right)
        return;

    f.mid = (left + right) / 2;

    mergeSort(a, temp, f.left, f.mid, depth + 1);
    mergeSort(a, temp, f.mid + 1, f.right, depth + 1);

    f.i = f.left;
    f.j = f.mid + 1;
    f.k = f.left;

    while (f.i <= f.mid && f.j <= f.right) {
        comparisons++;

        if (a[f.i] <= a[f.j])
            temp[f.k++] = a[f.i++];
        else
            temp[f.k++] = a[f.j++];
    }

    while (f.i <= f.mid)
        temp[f.k++] = a[f.i++];

    while (f.j <= f.right)
        temp[f.k++] = a[f.j++];

    for (f.i = f.left; f.i <= f.right; f.i++)
        a[f.i] = temp[f.i];
}

// 퀵 정렬
void quickSort(int a[], int low, int high, int type, int depth) {
    QuickFrame f;

    f.low = low;
    f.high = high;
    f.depth = depth;

    if (depth > maxDepth)
        maxDepth = depth;

    while (f.low < f.high) {

        // 피벗 선택
        if (type == 0) {
            f.pivotIndex = f.low;
        }
        else if (type == 1) {
            f.pivotIndex = f.low + rand() % (f.high - f.low + 1);
        }
        else {
            f.x = f.low;
            f.y = (f.low + f.high) / 2;
            f.z = f.high;

            // 세 원소의 중앙값 선택
            comparisons++;
            if (a[f.x] > a[f.y]) {
                f.temp = f.x;
                f.x = f.y;
                f.y = f.temp;
            }

            comparisons++;
            if (a[f.y] > a[f.z]) {
                f.temp = f.y;
                f.y = f.z;
                f.z = f.temp;
            }

            comparisons++;
            if (a[f.x] > a[f.y]) {
                f.temp = f.x;
                f.x = f.y;
                f.y = f.temp;
            }

            f.pivotIndex = f.y;
        }

        f.pivot = a[f.pivotIndex];

        // 3-way partition
        f.lt = f.low;
        f.i = f.low;
        f.gt = f.high;

        while (f.i <= f.gt) {
            comparisons++;

            if (a[f.i] < f.pivot) {
                f.temp = a[f.lt];
                a[f.lt] = a[f.i];
                a[f.i] = f.temp;

                f.lt++;
                f.i++;
            }
            else {
                comparisons++;

                if (a[f.i] > f.pivot) {
                    f.temp = a[f.gt];
                    a[f.gt] = a[f.i];
                    a[f.i] = f.temp;

                    f.gt--;
                }
                else {
                    f.i++;
                }
            }
        }

        // 작은 부분을 먼저 재귀 호출하여 스택 크기 제한
        if (f.lt - f.low < f.high - f.gt) {

            if (f.low < f.lt - 1)
                quickSort(a, f.low, f.lt - 1, type, depth + 1);

            f.low = f.gt + 1;
        }
        else {

            if (f.gt + 1 < f.high)
                quickSort(a, f.gt + 1, f.high, type, depth + 1);

            f.high = f.lt - 1;
        }
    }
}

// 정렬 결과 확인
int checkSorted(int a[], int n) {
    for (int i = 1; i < n; i++) {
        if (a[i - 1] > a[i])
            return 0;
    }

    return 1;
}

// 배열 복사
void copyArray(int a[], int b[], int n) {
    for (int i = 0; i < n; i++)
        b[i] = a[i];
}

int main() {
    int sizes[] = {1000, 2000, 4000, 8000, 16000, 20000};
    int count = 6;

    srand((unsigned int)time(NULL));

    for (int s = 0; s < count; s++) {
        int n = sizes[s];

        int* original = malloc(sizeof(int) * n);
        int* a = malloc(sizeof(int) * n);
        int* temp = malloc(sizeof(int) * n);

        if (original == NULL || a == NULL || temp == NULL) {
            printf("Memory allocation failed\n");
            free(original);
            free(a);
            free(temp);
            return 1;
        }

        // 무작위 데이터 생성
        for (int i = 0; i < n; i++)
            original[i] = rand() % 100001;

        printf("\nData Size : %d\n", n);
        printf("%-16s %12s %12s %15s\n",
               "Algorithm", "Comparisons", "Time(ms)", "Memory(Bytes)");
        printf("------------------------------------------------------------\n");

        clock_t start, end;
        double time;
        unsigned long long memory;

        copyArray(original, a, n);

        comparisons = 0;
        maxDepth = 0;

        start = clock();
        mergeSort(a, temp, 0, n - 1, 1);
        end = clock();

        time = (double)(end - start) * 1000 / CLOCKS_PER_SEC;

        memory = (unsigned long long)n * sizeof(int)
               + (unsigned long long)maxDepth * sizeof(MergeFrame);

        printf("%-16s %12llu %12.3f %15llu %s\n",
               "Merge Sort", comparisons, time, memory,
               checkSorted(a, n) ? "(OK)" : "(ERROR)");

        char* names[] = {
            "Quick (First)",
            "Quick (Random)",
            "Quick (Median3)"
        };

        for (int type = 0; type < 3; type++) {
            copyArray(original, a, n);

            comparisons = 0;
            maxDepth = 0;

            start = clock();
            quickSort(a, 0, n - 1, type, 1);
            end = clock();

            time = (double)(end - start) * 1000 / CLOCKS_PER_SEC;

            memory = (unsigned long long)maxDepth * sizeof(QuickFrame);

            printf("%-16s %12llu %12.3f %15llu %s\n",
                   names[type], comparisons, time, memory,
                   checkSorted(a, n) ? "(OK)" : "(ERROR)");
        }

        free(original);
        free(a);
        free(temp);
    }

    return 0;
}
